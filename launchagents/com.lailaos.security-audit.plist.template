<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lailaos.security-audit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/laila-os/scripts/security-audit.sh</string>
  </array>

  <!-- Monthly, on the 1st at 06:30. Findings go to the command channel via
       telegram-notify; the dead-man ping (HC_SECURITY_AUDIT_URL) catches the
       loop itself going quiet. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/lailaos-security-audit.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/lailaos-security-audit.err.log</string>
</dict>
</plist>
