<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lailaos.dashboard</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.nvm/versions/node/__NODE_VERSION__/bin/node</string>
    <string>__HOME__/laila/dashboard/server.js</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/lailaos-dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/lailaos-dashboard.err.log</string>
</dict>
</plist>
