{
  "_description": "Maps trigger phrases to domain AGENTS.md context files for loading. 'state' is the domain lifecycle: active | dormant | complete | killed | archived. Do NOT execute a domain's Check workflow unless state is 'active' \u2014 surface the state instead. 'nested_git' marks domains that are their own gitignored git repo inside this repo (other-worlds pattern), with a compatibility symlink at code_alias. Optional 'meeting_routing' makes a meeting-notes processor auto-file meeting notes to the domain: email_domains (participant handle domains), people (full names), company_names, title_keywords are match signals; filing.correspondence_dir is the stub destination (repo-relative). Only active domains participate.",
  "triggers": [
    {
      "patterns": [
        "Check career",
        "Help me pitch"
      ],
      "context_file": "domains/career/AGENTS.md",
      "state": "active",
      "nested_git": true,
      "code_alias": "~/Code/career-tools",
      "meeting_routing": {
        "email_domains": [
          "verdantgrid.example.com",
          "solstice-analytics.example.com"
        ],
        "people": [
          "Marcus Webb",
          "Priya Chandran"
        ],
        "company_names": [
          "Verdant Grid",
          "Solstice Analytics",
          "Heliotrope"
        ],
        "title_keywords": [
          "discovery",
          "proposal",
          "scoping"
        ],
        "filing": {
          "correspondence_dir": "domains/career/correspondence"
        }
      }
    },
    {
      "patterns": [
        "Check health"
      ],
      "context_file": "domains/health/AGENTS.md",
      "state": "active"
    },
    {
      "patterns": [
        "Check household",
        "Check smart home",
        "Smart home maintenance"
      ],
      "context_file": "domains/household/AGENTS.md",
      "state": "active"
    },
    {
      "patterns": [
        "Content ideas",
        "Write for LinkedIn"
      ],
      "context_file": "domains/content/AGENTS.md",
      "state": "active"
    },
    {
      "patterns": [
        "Check acme",
        "Acme status",
        "Prep for Jordan",
        "Engagement status"
      ],
      "context_file": "domains/acme/AGENTS.md",
      "state": "active",
      "meeting_routing": {
