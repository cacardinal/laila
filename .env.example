# Laila environment — copy to .env, fill in real values.
# .env is gitignored and must NEVER be committed: the nightly consolidation
# job auto-commits and auto-pushes, so any secret in a tracked file reaches
# your remote within a day.

# Absolute path to this repo (scripts fall back to $HOME/laila if unset)
LAILA_OS_ROOT=$HOME/laila

# ─── Telegram (notifications + command channel) ──────────────────────────────
# Create a bot via @BotFather, then message it and read the chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional per-domain groups (see config/telegram-groups.json). Unset vars
# fall back to TELEGRAM_CHAT_ID.
TELEGRAM_HOUSEHOLD_CHAT_ID=

# ─── healthchecks.io dead-man switches ───────────────────────────────────────
# One check per background loop. Paste each check's ping URL here; scripts
# no-op the ping when the var is empty.
HC_HEARTBEAT_URL=
HC_NIGHTLY_CONSOLIDATION_URL=
HC_DAILY_BRIEF_URL=

# ─── Dashboard + CRM proxy (docs/crm-twenty.md) ──────────────────────────────
DASHBOARD_PORT=5175
CRM_GRAPHQL_URL=http://localhost:3000/graphql
CRM_API_KEY=
HC_SECURITY_AUDIT_URL=

# ─── Agent runner (platform-agnostic) ────────────────────────────────────────
# Non-interactive agent command used by background loops; reads prompt on stdin.
# Default: the Claude Code reference implementation. Swap for your harness —
# equivalents table in docs/headless-sessions.md.
# AGENT_RUN=claude --print --model sonnet --allowedTools Read,Glob,Grep,Edit,Write

# ─── Telegram inbound bot (scripts/telegram-bot.py) ──────────────────────────
# Your NUMERIC user ID — the only sender the bot answers. Find it: message
# @userinfobot on Telegram, or read the "from.id" of your getUpdates test.
TELEGRAM_ALLOWED_USER_ID=
HC_TELEGRAM_BOT_URL=
AGENT_TIMEOUT_SECONDS=600
